# Configuración del Entorno — Bitácora TI Insigneo
PORT=3000
NODE_ENV=production
DATA_DIR=/data
TZ=America/Caracas

# Contraseña de acceso único a la aplicación (Cámbiala por una segura)
APP_PASSWORD=cambiar_por_tu_password_seguro

# Secreto para firmar las cookies HMAC-SHA256 (32+ caracteres aleatorios)
COOKIE_SECRET=insigneo_super_secret_cookie_key_random_32_chars_2026

# Horario semanal laboral en Insigneo (Lunes a Viernes 8:00am a 5:00pm)
SCHEDULE=1|08:00|17:00,2|08:00|17:00,3|08:00|17:00,4|08:00|17:00,5|08:00|17:00
START_DATE=2026-10-01
APP_TITLE=Insigneo — Soporte TI
